#!/usr/bin/env python3
# embo-usage — read and summarise embo session telemetry.
#
# Why: embo writes one telemetry record per session (via the Stop hook,
# see plugin/hooks/embo-telemetry-write.sh) to per-session files under
# .claude/embo_state/telemetry/. This tool aggregates those files so a
# user can see what their sessions cost and compare profiles.
#
# Usage:
#   embo-usage                 table of all sessions
#   embo-usage --last N        only the N most recent sessions
#   embo-usage --profile NAME  only sessions that used profile NAME
#   embo-usage --stats         aggregate stats (counts, mean/median)
#   embo-usage --json          emit stats as a JSON object
#
# --stats and --json summarise; the default and --last/--profile list.
# --json implies stats output in JSON form.
#
# Reads from the MAIN git working tree's .claude/ so it works the same
# from inside a git worktree. Runs as a plain command with only the
# Python stdlib (see plugin/bin/embo-profile for the allowlist reasoning).

import argparse
import glob
import json
import os
import subprocess
import sys


def main_tree_claude_dir():
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        if out:
            return os.path.join(os.path.dirname(out), ".claude")
    except Exception:
        pass
    return ".claude"


def telemetry_dir():
    return os.path.join(main_tree_claude_dir(), "embo_state", "telemetry")


def load_records(tel_dir):
    records = []
    for path in glob.glob(os.path.join(tel_dir, "*.jsonl")):
        try:
            with open(path, "r", encoding="utf-8") as f:
                line = f.readline().strip()
            if line:
                records.append(json.loads(line))
        except Exception:
            continue
    records.sort(key=lambda r: r.get("ts", ""))
    return records


def fmt_duration(secs):
    if secs is None:
        return "-"
    try:
        secs = int(secs)
    except (TypeError, ValueError):
        return "-"
    h, rem = divmod(secs, 3600)
    m, s = divmod(rem, 60)
    if h:
        return f"{h}h{m:02d}m"
    if m:
        return f"{m}m{s:02d}s"
    return f"{s}s"


def render_table(records):
    if not records:
        return "No telemetry records found."
    header = f"{'date':<20} {'session':<10} {'profile':<10} {'dur':>7} {'tools':>6} commands"
    lines = [header, "-" * len(header)]
    for r in records:
        date = r.get("ts", "")[:19].replace("T", " ")
        sid = str(r.get("session_id", ""))[:8]
        profile = str(r.get("profile", ""))[:10]
        dur = fmt_duration(r.get("duration_s"))
        tools = r.get("tool_call_count")
        tools = "-" if tools is None else str(tools)
        cmds = ",".join(r.get("commands", []) or [])[:40]
        lines.append(f"{date:<20} {sid:<10} {profile:<10} {dur:>7} {tools:>6} {cmds}")
    return "\n".join(lines)


def median(values):
    if not values:
        return 0
    s = sorted(values)
    n = len(s)
    mid = n // 2
    if n % 2:
        return s[mid]
    return (s[mid - 1] + s[mid]) / 2


def compute_stats(records):
    tool_counts = [r["tool_call_count"] for r in records
                   if isinstance(r.get("tool_call_count"), int)]
    profiles = {}
    for r in records:
        p = r.get("profile", "unknown")
        profiles[p] = profiles.get(p, 0) + 1
    mean = sum(tool_counts) / len(tool_counts) if tool_counts else 0
    return {
        "sessions": len(records),
        "mean_tool_calls": round(mean, 1),
        "median_tool_calls": median(tool_counts),
        "profile_distribution": profiles,
    }


def render_stats(stats):
    lines = [
        f"sessions:            {stats['sessions']}",
        f"mean tool calls:     {stats['mean_tool_calls']}",
        f"median tool calls:   {stats['median_tool_calls']}",
        "profile distribution:",
    ]
    for prof, count in sorted(stats["profile_distribution"].items()):
        lines.append(f"  {prof:<12} {count}")
    return "\n".join(lines)


def parse_args(argv):
    p = argparse.ArgumentParser(prog="embo-usage", add_help=True)
    p.add_argument("--last", type=int, default=None, metavar="N")
    p.add_argument("--profile", type=str, default=None, metavar="NAME")
    p.add_argument("--stats", action="store_true")
    p.add_argument("--json", action="store_true")
    return p.parse_args(argv)


def main(argv):
    args = parse_args(argv)
    records = load_records(telemetry_dir())

    if args.profile:
        records = [r for r in records if r.get("profile") == args.profile]

    if args.last is not None:
        records = records[-args.last:] if args.last > 0 else []

    if args.json:
        print(json.dumps(compute_stats(records)))
        return 0
    if args.stats:
        print(render_stats(compute_stats(records)))
        return 0
    print(render_table(records))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
