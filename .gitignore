# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# RLM state (don't commit state files)
.claude/rlm_state/
*.pkl

# Harness runtime state (halt marker, cleared log, violation log, diag)
.claude/embo_state/

# Correction curation bookkeeping (per-project, written by /embo:improve)
.claude/correction-curation.json

# Correction capture JSONL (per-project, written by the capture-correction hook)
.claude/corrections.jsonl

# Scratch dir for redirected command output (read back via the Read tool)
tmp/

# Repo-adjacent git worktrees (embo-worktree-finish default location)
.worktrees/

# Logs
*.log

# Playwright CLI session artifacts (screenshots + console logs)
.playwright-cli/

# Personal git-context marker (gh-context account switcher; per-user, never shared)
.ghcontext

# Author mapping (personal; not tracked in the repo)
.mailmap
